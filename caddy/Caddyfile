# TLS terminator in front of Gradio / FastAPI.
# Host lock + optional Basic Auth are generated at start (/tmp/caddy-*.inc).
# Inference stays plain HTTP on the Docker network (Orthanc → http://inference:7860).
#
# Container always listens on :8443 (compose maps host CADDY_HTTPS_PORT → 8443).

{
	auto_https off
}

:8443 {
	tls /etc/caddy/certs/localhost.crt /etc/caddy/certs/localhost.key
	import /tmp/caddy-hostgate.inc
	import /tmp/caddy-site.inc
}
