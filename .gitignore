.env
.DS_Store

# Optional local CXAS weights (large binary; do not commit)
cxas/weights/*.pth

# TLS + Basic Auth secrets (generate locally; never commit)
certs/*.crt
certs/*.key
certs/*.pem
auth/users.basicauth
auth/*.htpasswd

# Oracle / cloud SSH keys (never commit)
ssh-key*.key
ssh-key*.key.pub
*.pem
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

orthanc/python/__pycache__/
