# Copy to .env and edit before first deploy:
#   cp .env.sample .env

# Docker Hub images (defaults match sdscotti public/private split)
# Local Apple Silicon testing: use :arm64 (native).
# Docker Hub / x86 distro hosts: use :amd64 (build with DOCKER_DEFAULT_PLATFORM=linux/amd64).
CXAS_API_IMAGE=sdscotti/cxr-preprocess-api:latest
INFER_IMAGE=sdscotti/breader-inference:latest
ORTHANC_IMAGE=sdscotti/orthanc-breader:latest
AUTHGATE_IMAGE=sdscotti/breader-authgate:latest
CADDY_IMAGE=caddy:2-alpine

# Examples:
# CXAS_API_IMAGE=sdscotti/cxr-preprocess-api:arm64
# INFER_IMAGE=sdscotti/breader-inference:arm64
# ORTHANC_IMAGE=sdscotti/orthanc-breader:arm64
# AUTHGATE_IMAGE=sdscotti/breader-authgate:arm64
# CXAS_API_IMAGE=sdscotti/cxr-preprocess-api:amd64
# INFER_IMAGE=sdscotti/breader-inference:amd64
# ORTHANC_IMAGE=sdscotti/orthanc-breader:amd64
# AUTHGATE_IMAGE=sdscotti/breader-authgate:amd64

# Required to pull private inference image (read-only token is enough).
# Public images (cxas, orthanc, caddy, authgate) pull without login; inference needs auth.
DOCKER_HUB_USERNAME=sdscotti
DOCKER_HUB_TOKEN=

# Host ports
# Public: Caddy HTTPS Gradio/API. Production: CADDY_HTTPS_PORT=443 (maps host 443 → container 8443).
# Localhost-only: inference HTTP debug, CXAS, Orthanc UI, Orthanc DICOM
#   (reach Orthanc remotely with: ssh -L 8042:127.0.0.1:8042 user@host)
CADDY_HTTPS_PORT=8443
INFER_HOST_PORT=7860
CXAS_HOST_PORT=8081
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242

# Public hostname (empty = any Host header, for local IP/localhost).
# Production: only this name is accepted; other Hosts (including raw IP) get 421.
CADDY_HOSTNAME=breader.medinformatics.eu

# TLS + optional Basic Auth (do not commit passwords):
#   EXTRA_DNS=breader.medinformatics.eu ./scripts/gen_localhost_certs.sh
#   ./scripts/gen_basicauth_users.sh breader 'your-long-password'
# Cloudflare: A record → VPS IP. Grey-cloud (DNS only) is simplest with a self-signed
# origin cert. Orange-cloud: SSL/TLS mode Full (not Flexible); Full (strict) needs a
# Cloudflare Origin CA cert in certs/localhost.crt + localhost.key.
#
# HTTP Basic Auth (same users.basicauth file). false = public Gradio, no password prompt.
CADDY_BASIC_AUTH=true
#
# Auth lockout when CADDY_BASIC_AUTH=true (wrong password only; blank prompt does not count):
AUTHGATE_MAX_FAILURES=3
AUTHGATE_LOCKOUT_SECONDS=900

# Resource limits (inference needs ~12 GB RAM during DICOM predict on CPU)
INFER_SHM_SIZE=2gb
INFER_MEM_LIMIT=12g
CXAS_SHM_SIZE=2gb
CXAS_MEM_LIMIT=8g

# Optional: pin a release after maintainer tags images
# INFER_IMAGE=sdscotti/breader-inference:2026-06-17
# CXAS_API_IMAGE=sdscotti/cxr-preprocess-api:2026-06-17
# ORTHANC_IMAGE=sdscotti/orthanc-breader:2026-06-17

# INFER_ARTIFACT_DIR=/code/inference/artifacts/google_elixr_8bit
# INFER_EMBEDDING_KIND=elixr-768
