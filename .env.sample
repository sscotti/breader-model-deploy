# Copy to .env and edit before first deploy:
#   cp .env.sample .env

# Docker Hub images (defaults match sdscotti public/private split)
CXAS_API_IMAGE=sdscotti/cxr-preprocess-api:latest
INFER_IMAGE=sdscotti/breader-inference:latest
ORTHANC_IMAGE=sdscotti/orthanc-breader:latest

# Required to pull private inference image (read-only token is enough).
# Public images (cxas, orthanc) pull without login; inference needs auth.
DOCKER_HUB_USERNAME=sdscotti
DOCKER_HUB_TOKEN=

# Host ports (change if 7860/8081/8042 are taken)
INFER_HOST_PORT=7860
CXAS_HOST_PORT=8081
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242

# Optional resource limits
# CXAS_SHM_SIZE=2gb
# CXAS_MEM_LIMIT=8g
# INFER_SHM_SIZE=2gb
